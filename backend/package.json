    "name": "Bhupesh Dewangan",
    "email": "bhupeshdewangan20@gmail.com"
  },
  "main": "dist/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build -b swc --type-check",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start -b swc --type-check",
    "start:dev": "nest start --watch -b swc",
    "start:debug": "nest start --debug --watch -b swc --type-check",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prepare": "husky || true",
    "commit": "git-cz"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@clickhouse/client": "^1.12.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/graphql": "^13.2.0",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "^6.17.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dataloader": "^2.2.3",
    "graphql": "^16.11.0",
    "graphql-type-json": "^0.3.2",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.6",
    "neo4j-driver": "^6.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.37.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.5",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "prisma": "^6.17.1",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@swc/core",
      "unrs-resolver"
    ],
    "overrides": {
      "path-to-regexp@<0.1.12": ">=0.1.12",
      "tmp@<=0.2.3": ">=0.2.4",
      "sha.js@<=2.4.11": ">=2.4.12"
    }
  },
  "packageManager": "pnpm@10.18.3"
}
