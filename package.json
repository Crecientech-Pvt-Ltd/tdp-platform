{
  "name": "tdp-platform",
  "version": "2.1.0-beta",
  "private": true,
  "description": "TDP Platform",
  "scripts": {
    "prepare": "husky || true",
    "commit": "cz",
    "frontend": "cd frontend && pnpm dev:turbo",
    "backend": "cd backend && pnpm start:dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crecientech-Pvt-Ltd/tdp-platform.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Crecientech-Pvt-Ltd/tdp-platform/issues"
  },
  "homepage": "https://github.com/Crecientech-Pvt-Ltd/tdp-platform#readme",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/cz-commitlint": "^20.1.0",
    "commitizen": "^4.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx,json,jsonc}": [
      "pnpm -C frontend check"
    ],
    "backend/**/*.{js,ts}": [
      "pnpm -C backend lint",
      "pnpm -C backend format"
    ]
  }
}
