// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Session {
  id          String        @id @default(uuid())  // Unique session ID stored in JWT
  createdAt   DateTime      @default(now())
  combinations Combination[]
}

model Combination {
  session    Session     @relation(fields: [sessionId], references: [id])
  sessionId  String
  group      String
  program    String
  project    String
  verifiedAt DateTime    @default(now())

  @@id([sessionId, group, program, project])
  @@index([sessionId, group, program, project])
}

model Feedback {
  id        String   @id @default(uuid())
  name      String
  email     String
  text      String   @db.Text
  status    String   @default("pending")  // 'pending' or 'taken'
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}